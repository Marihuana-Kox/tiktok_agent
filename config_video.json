{
    "video_settings": {
      "fps": 30,
      "resolution": "1080x1920",
      "codec": "libx264",
      "audio_codec": "aac",
      "transition_duration": 0.5
    },
    
    "effects": {
        "ken_burns": {
            "enabled": true,
            "zoom_speed": 0.5,
            "directions": ["zoom_in", "zoom_out", "none"]
        },
        "rotation": {
            "enabled": true,
            "max_angle": 3,
            "probability": 0.4
        },
        "flip": {
            "enabled": true,
            "probability": 0.15
        },
        "color": {
            "enabled": true,
            "contrast": 1.2,
            "saturation": 1.15
        }
    },
    
    "timing": {
      "first_image_multiplier": 1.3,
      "last_image_multiplier": 1.3,
      "middle_images_multiplier": 0.85,
      "min_image_duration": 4.0,
      "max_image_duration": 12.0
    },
    
    "style_presets": {
      "dynamic": {
        "ken_burns": true,
        "rotation": true,
        "flip": true,
        "color": true,
        "transition": 0.3,
        "description": "Быстрые переходы, много движения"
      },
      "cinematic": {
        "ken_burns": true,
        "rotation": false,
        "flip": false,
        "color": true,
        "transition": 0.8,
        "description": "Плавные переходы, медленный зум"
      },
      "minimal": {
        "ken_burns": false,
        "rotation": false,
        "flip": false,
        "color": false,
        "transition": 0.5,
        "description": "Без эффектов, только fade"
      },
      "crazy": {
        "ken_burns": true,
        "rotation": true,
        "flip": true,
        "color": true,
        "transition": 0.2,
        "description": "Максимум эффектов для TikTok"
      }
    },
    
    "active_preset": "dynamic"
  }